{
  "manifest_version": 3,
  "name": "AutoGroupPilot - AI Facebook Group Poster",
  "version": "1.0.0",
  "description": "Safe, smart multi-group poster for Facebook with human-like anti-ban pacing, Cloudflare Workers AI rewriting, and auto first-comment.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AutoGroupPilot"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.workers.dev/*",
    "http://localhost:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "utils/spintax.js",
        "utils/humanizer.js",
        "content/fb_poster.js"
      ],
      "css": [
        "content/fb_injected.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
